# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채우세요.  (cp .env.example .env)
# .env 는 git에 올라가지 않습니다.

# 공공데이터포털 인증키 — 마이페이지 > 활용신청 현황의 "일반 인증키 (Decoding)"
KMA_SERVICE_KEY=

# DB 비밀번호 (비워두면 개발용 기본값 demold / demold-root)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# AI 상담용 LLM 서버 (OpenAI 호환 /v1/chat/completions, tool calling 지원 모델). 키는 외부 공유 금지
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen

# 측압 weight 단위가 g 인 센서 MAC (쉼표 구분). 나머지는 kg 로 본다
GRAM_SENSORS=

# 센서 목록 화면에서 숨길 센서 MAC (쉼표 구분)
HIDDEN_SENSORS=

# 초기 적재(scripts.seed)용 센서 CSV 폴더 (webapp 기준 상대경로)
SEED_SENSOR_DIR=../private_data/sensors
