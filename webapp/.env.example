# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채우세요.  (cp .env.example .env)
# .env 는 git에 올라가지 않습니다.

# 공공데이터포털 인증키 — 마이페이지 > 활용신청 현황의 "일반 인증키 (Decoding)"
KMA_SERVICE_KEY=

# DB 비밀번호 (비워두면 개발용 기본값 demold / demold-root)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# AI 상담용 LLM 서버 (OpenAI 호환 /v1/chat/completions, tool calling 지원 모델). 키는 외부 공유 금지
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen
# 가이드라인 RAG 의미 검색용 임베딩 모델 (같은 서버·같은 키). 색인과 질문에 반드시 같은 모델을 쓴다
EMBED_MODEL=qwen-embedding

# 측압 weight 단위가 g 인 센서 MAC (쉼표 구분). 나머지는 kg 로 본다
GRAM_SENSORS=

# 센서 목록 화면에서 숨길 센서 MAC (쉼표 구분)
HIDDEN_SENSORS=

# 초기 적재(scripts.seed)용 센서 CSV 폴더 (webapp 기준 상대경로)
SEED_SENSOR_DIR=../private_data/sensors

# ---- 로그인 ----
# 사용자가 한 명도 없을 때 서버가 켜지면서 만드는 첫 관리자 (만든 뒤에는 화면에서 비밀번호를 바꾸세요)
# 비워 두면: docker compose -p demold_public exec backend python -m scripts.create_admin <ID>
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_NAME=관리자
# 로컬 개발용 권한별 시험 계정 (test-admin·test-editor·test-viewer, 비밀번호는 backend/app/test_users.py)
# 비밀번호가 코드에 공개돼 있으므로 실제 서비스에서는 반드시 false
SEED_TEST_USERS=false
# 마지막으로 쓴 뒤 이 시간(시간) 동안 아무것도 안 하면 로그아웃 (쓰는 동안은 자동 연장)
SESSION_HOURS=12
# 계속 쓰더라도 로그인 후 이 기간(일)이 지나면 다시 로그인
SESSION_MAX_DAYS=7
# 로그인 쿠키를 항상 HTTPS 전용으로 (HTTPS로 들어온 요청은 false 여도 자동으로 HTTPS 전용)
COOKIE_SECURE=false

# ---- 알림 메일 자동 발송 (SMTP) ----
# SMTP_HOST 를 비워 두면 자동 발송은 꺼지고, 대시보드에서 메일 초안만 엽니다.
# 켜면 NOTIFY_INTERVAL_MIN 분마다 회차(타설 후 28일 이내)를 확인해, 부재 해체 기준 도달 하루 전에 회차 설정의 '알림 받을 메일'로 보냅니다.
# 예) Gmail: smtp.gmail.com / starttls / 587 / 계정 주소 / 앱 비밀번호(2단계 인증 후 발급)
#     네이버: smtp.naver.com / ssl / 465 / 네이버 ID / 비밀번호 (메일 환경설정에서 SMTP 사용 켜기)
SMTP_HOST=
SMTP_SECURITY=starttls
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# 보내는 주소 (비우면 SMTP_USER). 메일 서버가 허용한 주소여야 합니다
SMTP_FROM=
SMTP_FROM_NAME=FormCast
NOTIFY_INTERVAL_MIN=10
# 메일 본문의 '자세히 보기' 링크에 쓸 화면 주소 (예: https://formcast.example.com). 비우면 http://localhost:8080
APP_URL=

# ---- 센서 데이터 자동 수집 (Databricks Delta Sharing) ----
# 협력사가 보낸 자격증명 파일(config.share)의 내 컴퓨터 경로 (절대 경로). 비우면 자동 수집은 꺼지고 CSV 업로드만 씁니다.
# ⚠ 이 파일에는 접속 토큰이 들어 있습니다. 저장소 밖(예: ~/.secrets/)에 두고 권한을 600 으로.
# 켜면 DELTA_SYNC_INTERVAL_MIN 분마다 새 측압·수분 데이터를 가져와 저장합니다 (backend/app/delta_sync.py)
DELTA_SHARE_FILE=
DELTA_SYNC_INTERVAL_MIN=10

# ---- HTTPS (실제 서비스) ----
# docker compose -p demold_public --profile https up -d  로 켜면 caddy 가 443 으로 받는다
# 도메인이면 인증서 자동 발급(Let's Encrypt), 내부 IP 면 자체 인증서 (브라우저 경고 1회)
SITE_ADDRESS=localhost
